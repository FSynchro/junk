Hoi, als je linux kiosk wil, hier systemd service (draaien onder sudo user en enablen: sudo systemctl enable --now ydotoold-dashboard)


# /etc/systemd/system/ydotoold-dashboard.service
[Unit]
Description=ydotoold for kiosk dashboard

[Service]
ExecStart=/usr/bin/ydotoold -p /run/ydotool-dashboard.sock -P 0600 -o 1001:1001
Restart=on-failure

[Install]
WantedBy=multi-user.target




